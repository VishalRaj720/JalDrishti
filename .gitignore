# docs/ was blanket-ignored while it held personal planning notes. Since the
# 2026-08-11 reorganisation `docs/audits/` is the tracked audit record and only
# `docs/local/` — scratch, reference PDFs, and the learning write-ups that were
# previously ignored as `/mdFiles`, `datasets_source.md`, `My_Proposal.pdf` —
# stays out of git.
docs/local/

# Generated data-quality report (rebuilt by `python -m scripts.seed`)
backend/reports/

/fetch_data

# Large / bulky datasets — regenerate via fetch_data/ scripts, don't commit.
# (comments MUST be on their own line — an inline # becomes part of the pattern)
# 703 MB GLO-30 DEM — rebuild with fetch_data/fetchDEM.py + mosaic_dem.py
Datasets/jharkhand_glo30_dem.tif
# 109 MB of CGWB NAQUIM source PDFs (reference material)
Datasets/naquim_reference/Jharkhand_NAQUIM_Reports/
newdataset/
# Raw Asia HydroRIVERS shapefile (207MB) -- clipped to Datasets/jharkhand_rivers.geojson
Datasets/HydroRIVERS_v10_as_shp/
# Downloaded reference PDFs for Phase-1 fidelity fixes (EPA Kd volumes, IAEA
# Tummalapalle doc) -- re-fetch from the public URLs cited in parameters.py /
# JHARKHAND_FIDELITY_MATRIX.md. The curated fulltext extraction of the Jaduguda
# mine-water paper (small, cited, human-readable) IS tracked, not ignored.
Datasets/phase1_sources/*.pdf

ml_pipeline/outputs/
# Model artifact bundles: 12 MB each, created by /model-ops/model-backups.
# The live artifacts/ dir is partly tracked; its backups never should be.
ml_pipeline/ml/artifact_bundles/

# Dataset backups written by /datasets/*/restore and the sync path.
Datasets/.backups/

# ── Backups (R12). NEVER COMMIT THESE ────────────────────────────────
# `scripts/backup.py` writes a full `pg_dump` here. It contains every argon2
# password hash, the entire audit log, and every account — a database dump is
# the single most sensitive artifact this project can produce, and the repo is
# public. Also the tree that `--restore` moves aside before overwriting.
backups/
Datasets.before-restore-*/
